# Jira MCP settings — configure either site (or both).
# mycompany (Data Center): PAT via Bearer auth.
JIRA_BASE_URL=https://jira.mycompany.com
JIRA_TOKEN=replace-with-your-jira-token
# mycompany (Atlassian Cloud): create token at
#   https://id.atlassian.com/manage-profile/security/api-tokens
#   Classic Cloud API tokens require HTTP Basic (email:token) — set both
#   JIRA_CLOUD_EMAIL and JIRA_CLOUD_TOKEN.
JIRA_CLOUD_BASE_URL=https://mycompany-prod.atlassian.net
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_TOKEN=

# Confluence MCP settings — configure either site (or both).
# mycompany (Atlassian Cloud): create token at
#   https://id.atlassian.com/manage-profile/security/api-tokens
#   Classic Cloud API tokens require HTTP Basic (email:token) — set both
#   CONFLUENCE_CLOUD_EMAIL and CONFLUENCE_CLOUD_TOKEN.
# mycompany (Data Center): create PAT at
#   https://library.mycompany.com/plugins/personalaccesstokens/usertokens.action
#   Uses Bearer auth.
CONFLUENCE_CLOUD_BASE_URL=https://mycompany-prod.atlassian.net/wiki
CONFLUENCE_CLOUD_EMAIL=
CONFLUENCE_CLOUD_TOKEN=
CONFLUENCE_ONPREM_BASE_URL=https://library.mycompany.com
CONFLUENCE_ONPREM_TOKEN=

# GHCR image owner/repo/tag. GHCR_REPO namespaces every lvx-* package under
# this repo (ghcr.io/<owner>/<repo>/lvx-<name>) so it can't collide with a
# same-named package from an unrelated repo in the same org.
GHCR_OWNER=johalduran7
GHCR_REPO=ai-mcp-docker
GHCR_TAG=latest

# Absolute host path to your AWS credentials directory.
# Example: /Users/johnduran/.aws
HOST_AWS_DIR=/Users/your-user/.aws

# Absolute host path to your awsume cache directory.
# Example: /Users/johnduran/.awsume
HOST_AWSUME_DIR=/Users/your-user/.awsume

# Optional default region used by boto3 when a profile has no region.
AWS_DEFAULT_REGION=us-east-1

# Grafana MCP settings
# lvx provider (MyCompany Grafana, one per env, LDAP Basic auth). Requires
# the Cisco AnyConnect VPN.
GRAFANA_URL_TEMPLATE=http://logging-ui.service.{env}.mycompany.net:8080
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
# mycompany provider (MyCompany org Grafana, the mon-* hosts). Requires the
# Forticlient VPN. The per-env mon-* URLs are hardcoded in
# servers/grafana/server.py; OKTA_DOMAIN below is optional (defaults to
# mycompany.okta.com).
OKTA_DOMAIN=
OKTA_USERNAME=
OKTA_PASSWORD=

# ArgoCD MCP settings
# Default target instance. Override per session if you need to point at a
# different ArgoCD (dev, staging, ...).
ARGOCD_SERVER=argocd.devops.mycompany.com
# Local OAuth2 callback port used during `argocd login --sso` inside the
# container. Deliberately different from argocd's own default 8085 so a
# container-side MCP login never collides with a host-terminal login;
# both write to the same shared ~/.config/argocd/config. Must match the
# port published on `docker run -p <port>:<port>`.
ARGOCD_SSO_PORT=8085
# Seconds to wait for the user to complete SSO in their browser.
ARGOCD_LOGIN_TIMEOUT=180
# Absolute host path to your argocd config directory (holds the shared
# session written by `argocd login`).
# Example: /Users/johnduran/.config/argocd
HOST_ARGOCD_DIR=/Users/your-user/.config/argocd
