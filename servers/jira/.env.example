# Copy this file to .env and set your values.
# At least ONE of the two tokens must be set. If only one is
# configured, all tools default to that site when called with
# site="auto". If both are configured, callers must pass
# site="onprem" or site="cloud" explicitly.

# ── onprem (internal Jira Server/Data Center) ─────────────────────────
# JIRA_TOKEN is injected by the AI host MCP configuration; do not hardcode it here.
JIRA_BASE_URL=https://jira.mycompany.com
JIRA_TOKEN=

# ── cloud (MyCompany Jira Cloud) ──────────────────────────────────────
# Create the token here (lasts one year):
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Auth is HTTP Basic (email:token) for classic Atlassian Cloud API
# tokens — set BOTH the email and the token. Without the email the
# server falls back to Bearer, which 403s on classic tokens.
JIRA_CLOUD_BASE_URL=https://mycompany-prod.atlassian.net
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_TOKEN=

