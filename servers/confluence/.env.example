# Copy this file to .env and set your values.
# At least ONE of the two tokens must be set. If only one is
# configured, all tools default to that site when called with
# site="auto". If both are configured, callers must pass
# site="cloud" or site="onprem" (or "both" on search tools).

# ── cloud (MyCompany Confluence Cloud) ────────────────────────────────
# Create the token here (lasts one year):
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Auth is HTTP Basic (email:token) for classic Atlassian Cloud API
# tokens — set BOTH the email and the token. Without the email the
# server falls back to Bearer, which 403s on classic tokens with
# "Current user not permitted to use Confluence".
CONFLUENCE_CLOUD_BASE_URL=https://mycompany-prod.atlassian.net/wiki
CONFLUENCE_CLOUD_EMAIL=
CONFLUENCE_CLOUD_TOKEN=

# ── onprem (internal Confluence Data Center) ──────────────────────────
# Create the token here (never expires):
#   https://library.mycompany.com/plugins/personalaccesstokens/usertokens.action
# Uses Bearer auth.
CONFLUENCE_ONPREM_BASE_URL=https://library.mycompany.com
CONFLUENCE_ONPREM_TOKEN=
